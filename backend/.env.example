# ============================================
# SON-IA Backend Configuration
# ============================================

# Application
APP_NAME=SON-IA
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# Database - PostgreSQL (Agentes)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sonia_db
POSTGRES_USER=sonia_user
POSTGRES_PASSWORD=sonia_password

# Database - SQL Server (Legacy BSS/OSS)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=integratel_bss
MSSQL_USER=sa
MSSQL_PASSWORD=your_password

# Database - Teradata
TERADATA_HOST=teradata-server
TERADATA_USER=td_user
TERADATA_PASSWORD=td_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Main LLM API (Groq)
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Gemini API (Google)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL_PRO=gemini-1.5-pro
GEMINI_MODEL_FLASH=gemini-1.5-flash

# Pinecone (Vector DB)
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX=sonia-embeddings

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@integratel.com
SMTP_PASSWORD=your-password

# Twilio (WhatsApp/SMS)
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_PHONE_NUMBER=+51999999999

# RPA
RPA_ENDPOINT=http://rpa-server:8080/api
RPA_API_KEY=your-rpa-key